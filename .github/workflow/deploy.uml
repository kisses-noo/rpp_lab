name: CD

on:
  pull_request:
    branches: ["gh-gh"]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
    - name: step one
      uses: actions/checkout@v4

    - name: step two
      uses: peaceiris/actions-gh-pages@v4
      with:
        github_token: ${{ secrets.GITHUB_TOKEN }}
        publish_dir: ./
        publish_branch: gh-gh
        destination_dir: publish/abc
